# =====================================================================
# PlanVista3D Unified Environment Configuration Example
# =====================================================================
# Copy this file to .env or .env.local to customize your local setup.
# Never commit active credentials, API keys, or private tokens to Git!
# =====================================================================

# Puter Serverless Worker URL (for Roomify project save/list/get persistence)
VITE_PUTER_WORKER_URL=https://planvista-3d.puter.work

# Frontend API URL (leave empty in local dev to use Vite proxy, or set to production backend URL)
# Example: VITE_API_BASE_URL=https://api.planvista3d.com/api
VITE_API_BASE_URL=

# Python Flask / Gunicorn Backend Service Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Optional: Persistent Storage Volume Paths for Model Generation
# In Docker or production Linux:
# UPLOAD_FOLDER=/app/backend/model-generation/uploads
# OUTPUT_FOLDER=/app/backend/model-generation/outputs

# Path to Blender 5.0 or 4.x Executable (if not on system PATH)
# On Windows, commonly: C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
# On macOS, commonly: /Applications/Blender.app/Contents/MacOS/Blender
# On Linux, commonly: /usr/bin/blender
BLENDER_PATH="C:\Program Files\Blender Foundation\Blender 5.0\blender.exe"

# Optional: Path to custom Python site-packages containing ezdxf
# PYTHON_SITE_PACKAGES="C:\Users\username\AppData\Roaming\Python\Python311\site-packages"

# Optional: Prototype Vision LLM configuration (for blueprint_to_3d.py only)
# OPENROUTER_API_KEY=your-openrouter-key-here
# MODEL_NAME=allenai/molmo-2-8b:free

